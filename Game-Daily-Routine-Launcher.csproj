<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Game_Daily_Routine_Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>res\icon.ico</ApplicationIcon>
    <AssemblyName>MaaaAssortedAssistantArranger</AssemblyName>
    <Version>3.1.2</Version>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;src\Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
    <Compile Remove="src\Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Resource Include="res\icon.ico" />
    <Content Include="$(MSBuildProjectDirectory)\artifacts\native-udp\Release\MaaaUdpProxy.exe" Link="components\udp\MaaaUdpProxy.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="docs\third-party\**\*;docs\udp-proxy*.md;README*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="src\Native\UdpProxy\**\*" Link="components\udp\source\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Import Project="src\Native\UdpProxy\UdpProxy.targets" />
  <Import Project="src\Build\UdpDependencies.targets" />

  <!-- publish 后自动压缩 -->
  <Target Name="ZipAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_Timestamp>$([System.DateTime]::Now.ToString('yyMMdd-HHmmss'))</_Timestamp>
      <_PlatformName Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_PlatformName>
      <_PlatformName Condition="'$(RuntimeIdentifier)' == ''">win-x64</_PlatformName>
      <_PackageType Condition="'$(SelfContained)' == 'true'">self-contained</_PackageType>
      <_PackageType Condition="'$(SelfContained)' != 'true'">portable</_PackageType>
      <_ZipDir>$(MSBuildProjectDirectory)\bin\Release-Archives</_ZipDir>
      <_ZipName>$(AssemblyName)-$(_PlatformName)-$(_PackageType)-$(_Timestamp).zip</_ZipName>
    </PropertyGroup>
    <MakeDir Directories="$(_ZipDir)" />
    <Delete Files="$(_ZipDir)\$(_ZipName)" Condition="Exists('$(_ZipDir)\$(_ZipName)')" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(_ZipDir)\$(_ZipName)" />
    <Message Importance="high" Text="Published zip: $(_ZipDir)\$(_ZipName)" />
  </Target>

</Project>
