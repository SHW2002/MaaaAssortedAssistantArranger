<Application x:Class="Game_Daily_Routine_Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Game_Daily_Routine_Launcher">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palettes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls/Core.xaml" />
                <ResourceDictionary Source="Themes/Controls/TextInputs.xaml" />
                <ResourceDictionary Source="Themes/Controls/Selections.xaml" />
                <ResourceDictionary Source="Themes/Controls/ScrollBars.xaml" />
                <ResourceDictionary Source="Themes/Disclosure.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Cards.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:TaskStateToColorConverter x:Key="TaskStateToColor" />
            <local:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
