<UserControl x:Class="Game_Daily_Routine_Launcher.Views.TaskUdpProxySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,8,0,0"
                IsEnabled="{Binding DataContext.CanEditTasks, RelativeSource={RelativeSource AncestorType=Window}}">
        <CheckBox Content="为此任务启用 UDP 代理" IsChecked="{Binding UdpProxyEnabled}" />
        <StackPanel Margin="0,6,0,0" Visibility="{Binding UdpProxyEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="生效进程:" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding UdpProxyProcessPreview}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="自定义(可空):" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UdpProxyProcessNames, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" VerticalContentAlignment="Center" Margin="0,6,0,0" AcceptsReturn="False"
                         ToolTip="留空自动使用游戏预设；没有预设时跟随监控进程。填写则覆盖自动结果，须为完整文件名（如 StarRail.exe），多个以逗号或分号分隔。匹配所有同名实例，不支持目录和通配符。" />
                <TextBlock Grid.Row="2" Text="SOCKS5:" VerticalAlignment="Center" Margin="0,6,0,0" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding UdpProxyHost, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" ToolTip="无需认证的 SOCKS5 主机名或 IPv4 地址" />
                    <TextBlock Grid.Column="1" Text=":" Margin="4,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding UdpProxyPort, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" ToolTip="FlClash 的混合或 SOCKS5 端口" />
                </Grid>
            </Grid>
            <TextBlock Margin="0,6,0,0" Foreground="#616161" FontSize="11" TextWrapping="Wrap"
                       Text="需要管理员权限。驱动及转发组件已随包提供，启动任务时自动准备；使用本机 FlClash 时自动跟随当前节点建立任务独立出口。先启动代理，再启动工具，监控进程退出后关闭。请监控任务全程存活的进程；上游须支持 UDP，并取消‘运行前关闭 FlClash’。" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="准备 UDP 组件" Style="{StaticResource SmallButton}"
                        Command="{Binding DataContext.PrepareUdpProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#616161"
                           Text="独立后台引擎，仅接管列出的程序的 UDP" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
