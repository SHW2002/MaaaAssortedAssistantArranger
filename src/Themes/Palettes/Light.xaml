<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InsetBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="TextPrimary" Color="#212121" />
    <SolidColorBrush x:Key="TextSecondary" Color="#616161" />
    <SolidColorBrush x:Key="DisabledBackground" Color="#EEEEEE" />
    <SolidColorBrush x:Key="TextDisabled" Color="#767676" />
    <SolidColorBrush x:Key="HoverBackground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1976D2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3F2FD" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#64B5F6" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B71C1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFEBEE" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#EF9A9A" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#C62828" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#D6E8FF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#212121" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#212121" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#212121" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6E8FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212121" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#767676" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D6E8FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#212121" />
</ResourceDictionary>
