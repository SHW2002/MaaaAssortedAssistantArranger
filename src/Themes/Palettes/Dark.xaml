<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#181B20" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#22262D" />
    <SolidColorBrush x:Key="InsetBackground" Color="#1C2026" />
    <SolidColorBrush x:Key="InputBackground" Color="#2A3039" />
    <SolidColorBrush x:Key="BorderBrush" Color="#4D5663" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E7E9EC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B2B8C2" />
    <SolidColorBrush x:Key="DisabledBackground" Color="#252A32" />
    <SolidColorBrush x:Key="TextDisabled" Color="#8C95A2" />
    <SolidColorBrush x:Key="HoverBackground" Color="#343C48" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2478C5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#328BDD" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#263C53" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#568FCA" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C63D3D" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DD4A4A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#442B31" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#9F565E" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFABA9" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#304D6E" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#606B7B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A3039" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E7E9EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#22262D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E7E9EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#22262D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E7E9EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#304D6E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E7E9EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8C95A2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#304D6E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E7E9EC" />
</ResourceDictionary>
